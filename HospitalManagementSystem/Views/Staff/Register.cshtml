@model HospitalManagementSystem.Models.StaffUser
@{
    ViewData["Title"] = "Staff Registration";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title mb-3">Staff Registration</h3>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="PasswordHash" class="form-label"></label>
                        <input asp-for="PasswordHash" class="form-control" type="password" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="Staff">Staff</option>
                            <option value="Receptionist">Receptionist</option>
                            <option value="Nurse">Nurse</option>
                            <option value="Doctor Assistant">Doctor Assistant</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Register</button>
                    <a asp-action="Login" class="btn btn-outline-secondary ms-2">Back to Login</a>
                </form>
            </div>
        </div>
    </div>
</div>
