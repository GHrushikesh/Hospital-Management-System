@model HospitalManagementSystem.Models.Doctor
@{
    ViewData["Title"] = "Edit Doctor";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="card-title mb-0" style="font-family: 'Space Grotesk', sans-serif;">Edit Specialist Credentials</h3>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to List</a>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.DoctorId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DoctorId" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold">Doctor Full Name *</label>
                            <input asp-for="FullName" class="form-control" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Specialty" class="form-label small fw-semibold">Specialty *</label>
                            <input asp-for="Specialty" class="form-control" required />
                            <span asp-validation-for="Specialty" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Qualification" class="form-label small fw-semibold">Medical Qualifications & Degrees *</label>
                            <input asp-for="Qualification" class="form-control" placeholder="e.g. MBBS, MD, DM" required />
                            <span asp-validation-for="Qualification" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label small fw-semibold">Login username *</label>
                            <input asp-for="Username" class="form-control" autocomplete="username" required />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold">New login password</label>
                            <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
                            <span class="form-text text-muted small">Leave blank to retain current password.</span>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RoomNumber" class="form-label small fw-semibold">Consultation Room Number</label>
                            <input asp-for="RoomNumber" class="form-control" />
                            <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Availability" class="form-label small fw-semibold">Availability Hours</label>
                            <input asp-for="Availability" class="form-control" />
                            <span asp-validation-for="Availability" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold">Contact Phone</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConsultationFee" class="form-label small fw-semibold">Consultation Fee</label>
                            <input asp-for="ConsultationFee" class="form-control" type="number" step="10" />
                            <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-4">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                                <label class="form-check-label fw-semibold" for="isActiveCheck">
                                    Active for OPD consultations
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button class="btn btn-primary px-4" type="submit">Update Doctor Details &rarr;</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
