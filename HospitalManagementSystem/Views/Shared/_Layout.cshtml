<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CareBridge Hospital</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalManagementSystem.styles.css" asp-append-version="true" />
</head>
@{
    var role = Context.Session.GetString("LoggedInUserRole");
    var isAdmin = string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase) || Context.Session.GetString("AdminAuthenticated") == "true";
    var isDoctor = string.Equals(role, "Doctor", StringComparison.OrdinalIgnoreCase);
    var isReceptionist = string.Equals(role, "Receptionist", StringComparison.OrdinalIgnoreCase);
    var isStaff = !isAdmin && !isDoctor && !isReceptionist && !string.IsNullOrWhiteSpace(role);
    var isGuest = !isAdmin && !isDoctor && !isReceptionist && !isStaff;
    var userName = Context.Session.GetString("LoggedInUserName") ?? (isAdmin ? Context.Session.GetString("AdminUsername") : null);
}
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-header">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">+</span>
                    @if (isAdmin)
                    {
                        <span>CareBridge <span class="badge bg-dark ms-1" style="font-size:0.65rem; letter-spacing:0.05em;">ADMIN</span></span>
                    }
                    else if (isDoctor)
                    {
                        <span>CareBridge <span class="badge bg-secondary ms-1" style="font-size:0.65rem; letter-spacing:0.05em;">DOCTOR PORTAL</span></span>
                    }
                    else if (isReceptionist)
                    {
                        <span>CareBridge <span class="badge bg-primary ms-1" style="font-size:0.65rem; letter-spacing:0.05em; background-color: var(--cb-slate) !important;">RECEPTION DESK</span></span>
                    }
                    else if (isStaff)
                    {
                        <span>CareBridge <span class="badge bg-secondary ms-1" style="font-size:0.65rem; letter-spacing:0.05em;">NURSE & WARD PORTAL</span></span>
                    }
                    else
                    {
                        <span>CareBridge Hospital</span>
                    }
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1 ms-lg-3">
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Operations Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Staff">Staff Management</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Index">Specialists</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="Index">Patients</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="Index">Appointments</a>
                            </li>
                        }
                        else if (isDoctor)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DoctorAccount" asp-action="Dashboard">Clinical Desk</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DoctorAccount" asp-action="MyStaff">My Staff Team</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DoctorAccount" asp-action="HireStaff">Hire Staff</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Staff" asp-action="WardOccupancy">Ward & Bed Status</a>
                            </li>
                        }
                        else if (isReceptionist)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Receptionist" asp-action="Dashboard">Front Desk Cockpit</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Staff" asp-action="EmergencyQueue">🚨 Central ER Triage</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Receptionist" asp-action="WalkInBooking">Walk-In Fast Booking</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="Index">Patient Master Index</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Staff" asp-action="WardOccupancy">Bed Occupancy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Receptionist" asp-action="PatientLocator">Patient / Room Locator</a>
                            </li>
                        }
                        else if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Staff" asp-action="Dashboard">Ward & Triage Cockpit</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Staff" asp-action="EmergencyQueue">🚨 Central ER Triage</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Staff" asp-action="WardOccupancy">Bed & Ward Occupancy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Patient" asp-action="Index">Patient Registration</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="GuestRequest">Book Consultation</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointment" asp-action="CheckStatus">Track Appointment</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-danger" asp-controller="Appointment" asp-action="Emergency">🚨 Emergency 24/7</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-lg-3 mt-3 mt-lg-0">
                        @if (isGuest)
                        {
                            <span class="user-pill">Public Guest</span>
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Staff / Doctor Portal</a>
                        }
                        else if (isDoctor)
                        {
                            <span class="user-pill">
                                Dr. @userName
                                @if (!string.IsNullOrWhiteSpace(Context.Session.GetString("DoctorRoomNumber")))
                                {
                                    <span class="text-muted ms-1">(@Context.Session.GetString("DoctorRoomNumber"))</span>
                                }
                            </span>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Logout">Sign out</a>
                        }
                        else if (isReceptionist)
                        {
                            <span class="user-pill">
                                Receptionist : @userName
                                @if (!string.IsNullOrWhiteSpace(Context.Session.GetString("StaffAssignedRoomOrWard")))
                                {
                                    <span class="text-muted ms-1">[@Context.Session.GetString("StaffAssignedRoomOrWard")]</span>
                                }
                            </span>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Logout">Sign out</a>
                        }
                        else if (isStaff)
                        {
                            <span class="user-pill">
                                @role : @userName
                                @if (!string.IsNullOrWhiteSpace(Context.Session.GetString("StaffAssignedRoomOrWard")))
                                {
                                    <span class="text-muted ms-1">[@Context.Session.GetString("StaffAssignedRoomOrWard")]</span>
                                }
                            </span>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Logout">Sign out</a>
                        }
                        else if (isAdmin)
                        {
                            <span class="user-pill">
                                Admin : @userName
                            </span>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Admin" asp-action="Logout">Sign out</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container app-main">
        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <strong>Success:</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is not null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <strong>Notice:</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] is not null)
        {
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand-block">
                    <div class="footer-brand"><span class="footer-mark">+</span>CareBridge Hospital</div>
                    <p class="footer-meta">Accredited clinical healthcare, inpatient wards, and 24/7 emergency response.</p>
                </div>
                <div class="footer-column">
                    <div class="footer-heading">Hospital Portal</div>
                    @if (isGuest)
                    {
                        <a class="footer-link" asp-controller="Home" asp-action="Index">Hospital Overview</a>
                        <a class="footer-link" asp-controller="Appointment" asp-action="GuestRequest">Book Consultation</a>
                        <a class="footer-link" asp-controller="Appointment" asp-action="CheckStatus">Track My Appointment</a>
                        <a class="footer-link" asp-controller="Account" asp-action="Login">Medical Staff & Doctor Access</a>
                    }
                    else if (isDoctor)
                    {
                        <a class="footer-link" asp-controller="DoctorAccount" asp-action="Dashboard">Clinical Desk</a>
                        <a class="footer-link" asp-controller="Account" asp-action="Logout">Sign out</a>
                    }
                    else if (isReceptionist)
                    {
                        <a class="footer-link" asp-controller="Receptionist" asp-action="Dashboard">Front Desk Cockpit</a>
                        <a class="footer-link" asp-controller="Receptionist" asp-action="WalkInBooking">Walk-In Booking</a>
                        <a class="footer-link" asp-controller="Patient" asp-action="Index">Patient Directory</a>
                        <a class="footer-link" asp-controller="Account" asp-action="Logout">Sign out</a>
                    }
                    else if (isStaff)
                    {
                        <a class="footer-link" asp-controller="Staff" asp-action="Dashboard">Ward Desk</a>
                        <a class="footer-link" asp-controller="Patient" asp-action="Index">Patient Directory</a>
                        <a class="footer-link" asp-controller="Account" asp-action="Logout">Sign out</a>
                    }
                    else if (isAdmin)
                    {
                        <a class="footer-link" asp-controller="Admin" asp-action="Dashboard">Operations Dashboard</a>
                        <a class="footer-link" asp-controller="Admin" asp-action="Staff">Staff Management</a>
                        <a class="footer-link" asp-controller="Doctor" asp-action="Index">Doctor Directory</a>
                        <a class="footer-link" asp-controller="Patient" asp-action="Index">Patient Master Index</a>
                    }
                </div>
                <div class="footer-column">
                    <div class="footer-heading">Emergency & Triage</div>
                    <span>🚨 24/7 Trauma Helpline: +1 555 019 9110</span>
                    <span>OPD Appointments: +1 555 014 2080</span>
                    <span>Emergency Response: care@carebridge.example</span>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year CareBridge Hospital Information System</span>
                <a class="footer-link" asp-controller="Home" asp-action="Privacy">Patient Privacy & Compliance</a>
                <span class="footer-note">HIPAA & Clinical Confidentiality Protected</span>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
