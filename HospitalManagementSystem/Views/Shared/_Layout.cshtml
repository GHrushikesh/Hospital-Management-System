@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Management System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalManagementSystem.styles.css" asp-append-version="true" />
</head>
<body class="bg-light m-0 p-0">
    @if (HttpContextAccessor.HttpContext?.Session.GetString("AdminUser") != null)
    {
        <!-- Authenticated Admin Layout with Shared Sidebar Navigation -->
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <div class="bg-dark text-white border-end border-secondary shadow-lg d-none d-md-block" id="sidebar-wrapper" style="min-width: 260px; min-height: 100vh; background-color: #0f172a !important;">
                <div class="sidebar-heading p-4 text-white font-weight-bold fs-5 d-flex align-items-center border-bottom border-secondary border-opacity-25" style="background: #1e293b;">
                    <i class="fa-solid fa-hospital-user text-primary fs-3 me-3"></i>
                    <span class="fw-bold tracking-wide">HMS Admin</span>
                </div>
                <div class="list-group list-group-flush pt-3">
                    <div class="px-3 pb-2 text-uppercase text-muted small fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Core Navigation</div>
                    <a class="list-group-item list-group-item-action py-3 px-4 border-0 text-white active fw-medium d-flex align-items-center shadow-sm" style="background-color: #3b82f6;" asp-controller="Dashboard" asp-action="Index">
                        <i class="fa-solid fa-gauge-high me-3 fs-5"></i> Dashboard
                    </a>
                    <div class="px-3 pt-4 pb-2 text-uppercase text-muted small fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Management Modules</div>
                    <a class="list-group-item list-group-item-action py-3 px-4 border-0 text-light d-flex align-items-center opacity-75" style="background: transparent;" href="#" title="Next Milestone">
                        <i class="fa-solid fa-bed-pulse me-3 fs-5 text-primary"></i> Patients
                    </a>
                    <a class="list-group-item list-group-item-action py-3 px-4 border-0 text-light d-flex align-items-center opacity-75" style="background: transparent;" href="#" title="Coming soon">
                        <i class="fa-solid fa-user-doctor me-3 fs-5 text-success"></i> Doctors
                    </a>
                    <a class="list-group-item list-group-item-action py-3 px-4 border-0 text-light d-flex align-items-center opacity-75" style="background: transparent;" href="#" title="Coming soon">
                        <i class="fa-solid fa-calendar-check me-3 fs-5 text-warning"></i> Appointments
                    </a>
                    <a class="list-group-item list-group-item-action py-3 px-4 border-0 text-light d-flex align-items-center opacity-75" style="background: transparent;" href="#" title="Coming soon">
                        <i class="fa-solid fa-file-invoice-dollar me-3 fs-5 text-info"></i> Billing
                    </a>
                </div>
            </div>

            <!-- Page Content -->
            <div id="page-content-wrapper" class="d-flex flex-column w-100 min-vh-100">
                <!-- Topbar -->
                <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm px-4 py-3">
                    <button class="btn btn-outline-primary me-3 d-md-none rounded-circle p-2" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <span class="navbar-brand mb-0 h3 fw-bolder text-dark d-none d-sm-flex align-items-center">
                        <i class="fa-solid fa-hospital-symbol text-primary me-2 d-md-none"></i>
                        Hospital Management System
                    </span>
                    <div class="ms-auto d-flex align-items-center">
                        <div class="me-4 d-flex align-items-center bg-light px-3 py-2 rounded-pill border">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                <i class="fa-solid fa-user-shield small"></i>
                            </div>
                            <span class="text-dark fw-medium small">
                                Welcome, <strong>@HttpContextAccessor.HttpContext.Session.GetString("AdminUser")</strong>!
                            </span>
                        </div>
                        <a class="btn btn-outline-danger btn-sm px-4 py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center" asp-controller="Account" asp-action="Logout">
                            <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
                        </a>
                    </div>
                </nav>

                <!-- Main Work Area -->
                <div class="container-fluid p-4 p-md-5 flex-grow-1">
                    @RenderBody()
                </div>

                <!-- Footer -->
                <footer class="border-top bg-white py-3 mt-auto text-muted small">
                    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
                        <div>&copy; 2026 - <strong>Hospital Management System</strong></div>
                        <div class="text-secondary">Engineered with .NET 10 & ADO.NET Architecture</div>
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Public Layout for Login and Authentication -->
        <div class="container-fluid bg-light min-vh-100 d-flex flex-column justify-content-center py-5">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
            <footer class="text-center text-muted small mt-5">
                &copy; 2026 - Hospital Management System B.Tech Project
            </footer>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Responsive sidebar toggle script for mobile devices
        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('sidebar-wrapper');
            if (toggle && sidebar) {
                toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (sidebar.classList.contains('d-none')) {
                        sidebar.classList.remove('d-none');
                        sidebar.style.position = 'absolute';
                        sidebar.style.zIndex = '1000';
                        sidebar.style.minHeight = '100vh';
                    } else {
                        sidebar.classList.add('d-none');
                    }
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
