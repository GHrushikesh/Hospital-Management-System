@model IReadOnlyList<HospitalManagementSystem.Models.StaffUser>
@{
    ViewData["Title"] = "My Clinical Staff Roster";
}

<section class="dashboard-intro mb-4">
    <div>
        <p class="eyebrow mb-1">CLINICAL TEAM MANAGEMENT</p>
        <h1 class="display-title">My Staff & Roster Allocation</h1>
        <p class="intro-copy">
            Clinical personnel recruited and supervised by <strong>@ViewBag.DoctorName</strong> (@ViewBag.Specialty).
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="HireStaff" class="btn btn-primary dashboard-action">+ Hire New Staff Member</a>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">&larr; Back to Clinical Desk</a>
    </div>
</section>

<div class="schedule-panel">
    <div class="section-heading">
        <div>
            <p class="eyebrow mb-1">MY HIRED TEAM</p>
            <h2>Clinical Personnel Assigned to Your Practice (@Model.Count)</h2>
        </div>
        <span class="schedule-date">Physician-Managed Clinical Workforce</span>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Staff Member</th>
                        <th>Role & Title</th>
                        <th>Qualifications</th>
                        <th>Assigned Ward / Room</th>
                        <th>Shift Timing</th>
                        <th>Contact</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model)
                    {
                        <tr>
                            <td>
                                <strong class="d-block" style="color: var(--cb-ink);">@staff.FullName</strong>
                                <span class="text-muted small">Username: @staff.Username | ID: @(string.IsNullOrWhiteSpace(staff.EmployeeId) ? "—" : staff.EmployeeId)</span>
                            </td>
                            <td>
                                <span class="badge text-bg-light border fw-semibold">@staff.Role</span>
                                <div class="text-muted small mt-1">@staff.JobTitle</div>
                            </td>
                            <td>
                                <span class="badge text-bg-secondary font-monospace" style="font-size: 0.78rem;">
                                    @(string.IsNullOrWhiteSpace(staff.Qualification) ? "Certified Staff" : staff.Qualification)
                                </span>
                            </td>
                            <td>
                                <strong class="text-dark">@(string.IsNullOrWhiteSpace(staff.AssignedRoomOrWard) ? "Department Floor" : staff.AssignedRoomOrWard)</strong>
                            </td>
                            <td>
                                <span class="badge text-bg-light border text-dark">
                                    @(string.IsNullOrWhiteSpace(staff.ShiftTiming) ? "General Duty" : staff.ShiftTiming)
                                </span>
                            </td>
                            <td>
                                <div class="small fw-semibold">@staff.PhoneNumber</div>
                                <div class="text-muted small">@staff.Email</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state p-5 text-center">
            <div style="font-size: 2.5rem;" class="mb-2">👨‍⚕️🤝🧑‍⚕️</div>
            <h5 class="fw-bold mb-1">No staff members hired yet</h5>
            <p class="text-muted small mb-3">You have not recruited any nurses, physician assistants, or ward personnel yet.</p>
            <a asp-action="HireStaff" class="btn btn-primary btn-sm">+ Hire Your First Staff Member</a>
        </div>
    }
</div>
