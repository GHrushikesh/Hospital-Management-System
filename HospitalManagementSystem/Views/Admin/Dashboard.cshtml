@model HospitalManagementSystem.Models.DashboardViewModel
@{
    ViewData["Title"] = "Administrator Operations Dashboard";
}

<section class="dashboard-intro mb-4">
    <div>
        <p class="eyebrow mb-1">HOSPITAL GOVERNANCE & OPERATIONS</p>
        <h1 class="display-title">Administrative Operations</h1>
        <p class="intro-copy">Hospital-wide oversight of clinical staff, consulting specialists, and scheduled care.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="CreateStaff" class="btn btn-primary dashboard-action">Onboard Staff Member &rarr;</a>
        <a asp-controller="Doctor" asp-action="Create" class="btn btn-outline-secondary dashboard-action">+ Add Specialist</a>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card metric-card">
            <div class="card-body">
                <div class="metric-label"><span class="metric-dot"></span>Master Patient Index</div>
                <p class="metric-value">@Model.PatientCount</p>
                <a asp-controller="Patient" asp-action="Index" class="metric-link">Manage patient records &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card metric-card">
            <div class="card-body">
                <div class="metric-label"><span class="metric-dot"></span>Active Specialists</div>
                <p class="metric-value">@Model.DoctorCount</p>
                <a asp-controller="Doctor" asp-action="Index" class="metric-link">View doctor credentials &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card metric-card">
            <div class="card-body">
                <div class="metric-label"><span class="metric-dot"></span>Appointments Booked</div>
                <p class="metric-value">@Model.AppointmentCount</p>
                <a asp-controller="Appointment" asp-action="Index" class="metric-link">All hospital appointments &rarr;</a>
            </div>
        </div>
    </div>
</div>

<div class="schedule-panel mt-4">
    <div class="section-heading">
        <div>
            <p class="eyebrow mb-1">REAL-TIME CLINICAL QUEUE</p>
            <h2>Today's Live Care Schedule</h2>
        </div>
        <span class="schedule-date">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</span>
    </div>

    @if (Model.TodayAppointments.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Patient</th>
                        <th>Doctor & Room</th>
                        <th>Type / Complaint</th>
                        <th>Vitals</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appointment in Model.TodayAppointments)
                    {
                        <tr>
                            <td><strong>@appointment.AppointmentDateTime.ToString("hh:mm tt")</strong></td>
                            <td>
                                <div class="fw-bold">@appointment.PatientName</div>
                                <span class="text-muted small">@appointment.PatientMRN</span>
                            </td>
                            <td>
                                <div>@appointment.DoctorName</div>
                                <span class="text-muted small">@appointment.DoctorSpecialty (Room: @appointment.DoctorRoomNumber)</span>
                            </td>
                            <td>
                                <div>@appointment.Reason</div>
                                @if (appointment.IsEmergency)
                                {
                                    <span class="badge bg-danger">🚨 Emergency</span>
                                }
                            </td>
                            <td>
                                <span class="badge text-bg-light border font-monospace small">@(string.IsNullOrWhiteSpace(appointment.VitalsSummary) ? "Pending" : appointment.VitalsSummary)</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@appointment.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">No scheduled appointments for today.</div>
    }
</div>
