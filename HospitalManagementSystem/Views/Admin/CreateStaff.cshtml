@model HospitalManagementSystem.Models.StaffUser
@{
    ViewData["Title"] = "Onboard Hospital Staff Member";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <p class="eyebrow mb-1">ADMINISTRATIVE ONBOARDING</p>
                        <h3 class="card-title mb-0" style="font-family: 'Space Grotesk', sans-serif;">Register Staff & Assign Room / Ward</h3>
                    </div>
                    <a asp-action="Staff" class="btn btn-outline-secondary btn-sm">&larr; Back to Directory</a>
                </div>

                <p class="text-muted small mb-4">
                    Provision internal healthcare staff credentials. Specify medical qualifications, designated physical room/ward, and shift timings.
                </p>

                <form asp-action="CreateStaff" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <!-- Personal & Account Details -->
                    <h6 class="fw-bold mb-3 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.08em; color: var(--cb-muted);">Account & Profile</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold">Full Name *</label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Sarah Connor, RN" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label small fw-semibold">Login Username *</label>
                            <input asp-for="Username" class="form-control" placeholder="e.g. sarah.nurse" required />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PasswordHash" class="form-label small fw-semibold">Initial Password *</label>
                            <input asp-for="PasswordHash" class="form-control" type="password" placeholder="Minimum 6 characters" required />
                            <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label small fw-semibold">Designated Role *</label>
                            <select asp-for="Role" class="form-select" required>
                                <option value="Nurse">Nurse</option>
                                <option value="Receptionist">Receptionist</option>
                                <option value="Doctor Assistant">Doctor Assistant</option>
                                <option value="Triage Officer">Triage Officer</option>
                                <option value="Staff">General Staff</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Qualifications, Room/Ward, Shift -->
                    <h6 class="fw-bold mb-3 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.08em; color: var(--cb-muted);">Clinical Qualifications & Ward Allocation</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label asp-for="Qualification" class="form-label small fw-semibold">Qualification & Certifications *</label>
                            <input asp-for="Qualification" class="form-control" placeholder="e.g. B.Sc Nursing, Critical Care Certified, BLS/ACLS" required />
                            <span asp-validation-for="Qualification" class="text-danger small"></span>
                            <div class="form-text text-muted">Mention medical degrees, nursing diplomas, or administrative certifications.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AssignedRoomOrWard" class="form-label small fw-semibold">Assigned Room or Ward Number *</label>
                            <input asp-for="AssignedRoomOrWard" class="form-control" placeholder="e.g. Ward 3B - Post-Op or ICU Bay 02 or Reception Desk A" required />
                            <span asp-validation-for="AssignedRoomOrWard" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ShiftTiming" class="form-label small fw-semibold">Designated Shift Timing *</label>
                            <select asp-for="ShiftTiming" class="form-select" required>
                                <option value="Morning (07:00 - 15:00)">Morning (07:00 - 15:00)</option>
                                <option value="Day (08:00 - 16:30)">Day (08:00 - 16:30)</option>
                                <option value="Evening (15:00 - 23:00)">Evening (15:00 - 23:00)</option>
                                <option value="Night (23:00 - 07:00)">Night (23:00 - 07:00)</option>
                                <option value="Rotational Duty">Rotational Duty</option>
                            </select>
                            <span asp-validation-for="ShiftTiming" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Department & Contact -->
                    <h6 class="fw-bold mb-3 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.08em; color: var(--cb-muted);">Department & Contact</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label small fw-semibold">Department *</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Inpatient Wards, Emergency Triage, Front Desk" required />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JobTitle" class="form-label small fw-semibold">Job Title *</label>
                            <input asp-for="JobTitle" class="form-control" placeholder="e.g. Senior Charge Nurse" required />
                            <span asp-validation-for="JobTitle" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EmployeeId" class="form-label small fw-semibold">Employee ID</label>
                            <input asp-for="EmployeeId" class="form-control" placeholder="e.g. EMP-N014" />
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold">Phone Number *</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="10-digit mobile" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label small fw-semibold">Hospital Email *</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="staff@carebridge.example" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-2">
                        <a asp-action="Staff" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Register & Assign Roster &rarr;</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
