@model HospitalManagementSystem.Models.GuestAppointmentViewModel
@{
    ViewData["Title"] = "Book Consultation or Emergency Appointment";
    var doctors = ViewBag.Doctors as IEnumerable<HospitalManagementSystem.Models.Doctor> ?? Enumerable.Empty<HospitalManagementSystem.Models.Doctor>();
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <p class="eyebrow mb-1">PATIENT INTAKE & SCHEDULING</p>
                        <h3 class="card-title mb-0" style="font-family: 'Space Grotesk', sans-serif;">Book Medical Appointment</h3>
                    </div>
                    <a asp-action="CheckStatus" class="btn btn-outline-secondary btn-sm">
                        Track existing booking &rarr;
                    </a>
                </div>

                <p class="text-muted small mb-3">
                    Select a specialist according to your clinical requirements. Qualifications and consultation rooms are listed for full transparency.
                </p>

                <!-- High-urgency diversion banner -->
                <div class="alert alert-danger d-flex align-items-center justify-content-between p-2 px-3 mb-4 rounded-3 border-danger" style="background: #fff5f5;">
                    <div class="d-flex align-items-center gap-2 small">
                        <span style="font-size: 1.25rem;">🚨</span>
                        <span><strong>Severe Trauma or Life Threat?</strong> Do not wait for standard OPD slots.</span>
                    </div>
                    <a asp-action="Emergency" class="btn btn-danger btn-sm py-1 px-3 fw-bold text-nowrap">
                        Go to 24/7 Emergency Dispatch &rarr;
                    </a>
                </div>

                @if (ViewBag.Submitted == true)
                {
                    if (ViewBag.IsEmergency == true)
                    {
                        <div class="alert alert-danger border-2 d-flex align-items-center gap-3 p-3 mb-4" role="alert" style="background:#fff3f3; border-color:#dc3545 !important;">
                            <span style="font-size: 2rem;">🚨</span>
                            <div>
                                <h5 class="alert-heading mb-1 text-danger fw-bold">Critical Emergency Alert Dispatched!</h5>
                                <p class="mb-0 text-dark small">Emergency Booking <strong>#@ViewBag.AppointmentId</strong> has been delivered directly to the doctor's real-time emergency desk with your symptom description. Please arrive at the hospital Emergency Ward immediately.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 p-3 mb-4" role="alert">
                            <span style="font-size: 1.5rem;">✓</span>
                            <div>
                                <h6 class="alert-heading mb-1 fw-bold">Appointment Request Submitted</h6>
                                <p class="mb-0 small">Your request <strong>#@ViewBag.AppointmentId</strong> has been registered. The consulting physician will review and approve your scheduled slot. You can track status using your phone number.</p>
                            </div>
                        </div>
                    }
                }

                <form asp-action="GuestRequest" method="post" id="appointmentForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <!-- Emergency Toggle Card -->
                    <div class="card mb-4 border-2" id="emergencyCard" style="border-color: #f5c2c7 !important; background: #fffcfc;">
                        <div class="card-body p-3">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsEmergency" id="isEmergencySwitch" style="cursor: pointer; width: 2.5em; height: 1.3em;">
                                <label class="form-check-label ms-2 fw-bold text-danger" for="isEmergencySwitch" style="cursor: pointer;">
                                    🚨 Mark this as a Critical Medical Emergency
                                </label>
                            </div>
                            <div class="text-muted small mt-1 ms-1">
                                Check this if the patient requires immediate urgent medical intervention. The consulting doctor will receive an instant high-priority emergency pop-up alert on their workstation.
                            </div>

                            <div id="emergencyDescriptionContainer" class="mt-3 @(Model.IsEmergency ? "" : "d-none")">
                                <label asp-for="EmergencyDescription" class="form-label text-danger fw-semibold small">
                                    Describe Acute Symptoms & Condition Severity <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="EmergencyDescription" class="form-control border-danger" rows="3" placeholder="E.g., Crushing chest pain radiating to arm for 20 mins, high fever with convulsion, heavy trauma/bleeding, severe shortness of breath..."></textarea>
                                <span asp-validation-for="EmergencyDescription" class="text-danger small"></span>
                                <div class="form-text text-muted">
                                    The on-duty doctor reads this description directly to verify urgency and prepare emergency room resources before arrival.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Patient Contact Information -->
                    <h6 class="fw-bold mb-3 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.08em; color: var(--cb-muted);">Patient Details</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label small fw-semibold">First Name <span class="text-danger">*</span></label>
                            <input asp-for="FirstName" class="form-control" placeholder="e.g. Michael" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label small fw-semibold">Last Name <span class="text-danger">*</span></label>
                            <input asp-for="LastName" class="form-control" placeholder="e.g. Vance" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label small fw-semibold">Gender <span class="text-danger">*</span></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Select Gender</option>
                                <option>Female</option>
                                <option>Male</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold">Mobile / Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="10-digit mobile number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address (Optional)</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="patient@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Doctor & Slot Selection -->
                    <h6 class="fw-bold mb-3 text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.08em; color: var(--cb-muted);">Doctor Selection & Consultation Slots</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label asp-for="DoctorId" class="form-label small fw-semibold">Consulting Specialist <span class="text-danger">*</span></label>
                            <select asp-for="DoctorId" class="form-select" id="doctorSelect" required>
                                <option value="">-- Choose Specialist (Qualifications & Room Listed Below) --</option>
                                @foreach (var doc in doctors)
                                {
                                    <option value="@doc.DoctorId">
                                        @doc.FullName — @doc.Specialty (@doc.Qualification) | Room: @(string.IsNullOrWhiteSpace(doc.RoomNumber) ? "OPD" : doc.RoomNumber) | Fee: @doc.ConsultationFee.ToString("C")
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="DoctorId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Preferred Consultation Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="slotDatePicker" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <!-- Interactive Time Slots Panel -->
                    <div class="card bg-light border mb-4" id="slotPickerCard">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold text-uppercase" style="letter-spacing: 0.05em; color: var(--cb-slate);">
                                    🕒 Available Consultation Slots (30-Min Intervals)
                                </span>
                                <span id="slotStatusBadge" class="badge text-bg-light border text-muted small">Select Doctor & Date</span>
                            </div>
                            <div id="slotsGrid" class="d-flex flex-wrap gap-2 pt-1">
                                <span class="text-muted small">Choose a consulting specialist and date above to load available clinic consultation slots.</span>
                            </div>
                            <!-- Hidden actual datetime input submitted to controller -->
                            <input type="hidden" asp-for="AppointmentDateTime" id="finalAppointmentDateTime" />
                            <span asp-validation-for="AppointmentDateTime" class="text-danger small d-block mt-2"></span>
                        </div>
                    </div>

                    <!-- Symptoms & Notes -->
                    <div class="mb-4">
                        <label asp-for="Reason" class="form-label small fw-semibold">Chief Medical Complaint / Purpose of Visit <span class="text-danger">*</span></label>
                        <input asp-for="Reason" class="form-control" placeholder="E.g., Routine cardiac review, sudden onset migraine, pediatric cough..." />
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label small fw-semibold">Additional Medical History or Notes (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Any known allergies, ongoing medications, or prior surgery..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            &larr; Back to Hospital
                        </a>
                        <button type="submit" class="btn btn-primary px-4 py-2" id="submitBtn">
                            Submit Appointment Request &rarr;
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const emergencySwitch = document.getElementById('isEmergencySwitch');
            const descContainer = document.getElementById('emergencyDescriptionContainer');
            const submitBtn = document.getElementById('submitBtn');
            const doctorSelect = document.getElementById('doctorSelect');
            const slotDatePicker = document.getElementById('slotDatePicker');
            const slotPickerCard = document.getElementById('slotPickerCard');
            const slotsGrid = document.getElementById('slotsGrid');
            const slotStatusBadge = document.getElementById('slotStatusBadge');
            const finalDateTimeInput = document.getElementById('finalAppointmentDateTime');

            function updateEmergencyUI() {
                if (emergencySwitch && emergencySwitch.checked) {
                    descContainer.classList.remove('d-none');
                    slotPickerCard.classList.add('d-none');
                    submitBtn.classList.remove('btn-primary');
                    submitBtn.classList.add('btn-danger');
                    submitBtn.innerHTML = '🚨 Dispatch Critical Emergency Request &rarr;';
                    // Set current time for emergency
                    const now = new Date();
                    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                    finalDateTimeInput.value = now.toISOString().slice(0, 16);
                } else {
                    descContainer.classList.add('d-none');
                    slotPickerCard.classList.remove('d-none');
                    submitBtn.classList.remove('btn-danger');
                    submitBtn.classList.add('btn-primary');
                    submitBtn.innerHTML = 'Submit Appointment Request &rarr;';
                }
            }

            function loadAvailableSlots() {
                if (emergencySwitch && emergencySwitch.checked) return;

                const doctorId = doctorSelect.value;
                const date = slotDatePicker.value;

                if (!doctorId || !date) {
                    slotsGrid.innerHTML = '<span class="text-muted small">Choose a consulting specialist and date above to load available clinic consultation slots.</span>';
                    slotStatusBadge.innerText = 'Select Doctor & Date';
                    slotStatusBadge.className = 'badge text-bg-light border text-muted small';
                    return;
                }

                slotStatusBadge.innerText = 'Querying Clinic Roster...';
                slotStatusBadge.className = 'badge text-bg-warning text-dark small';
                slotsGrid.innerHTML = '<div class="text-muted small py-2"><span class="spinner-border spinner-border-sm me-1"></span> Fetching live OPD slots...</div>';

                fetch(`/Appointment/GetDoctorAvailableSlots?doctorId=${encodeURIComponent(doctorId)}&date=${encodeURIComponent(date)}`)
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success || !data.slots || data.slots.length === 0) {
                            slotsGrid.innerHTML = `<span class="text-danger small">${data.message || 'No clinic slots found for this date.'}</span>`;
                            slotStatusBadge.innerText = 'Unavailable';
                            slotStatusBadge.className = 'badge text-bg-danger small';
                            return;
                        }

                        let html = '';
                        let availableCount = 0;

                        data.slots.forEach(slot => {
                            if (slot.isAvailable) {
                                availableCount++;
                                html += `<button type="button" class="btn btn-outline-primary btn-sm slot-btn" data-slot="${slot.slotDateTime}" onclick="selectSlot(this, '${slot.slotDateTime}')">
                                    ${slot.display}
                                </button>`;
                            } else {
                                html += `<button type="button" class="btn btn-light btn-sm border text-muted" disabled style="opacity: 0.55;" title="${slot.reason}">
                                    ${slot.display} <small>(${slot.reason})</small>
                                </button>`;
                            }
                        });

                        slotsGrid.innerHTML = html;
                        slotStatusBadge.innerText = `${availableCount} Slot(s) Available`;
                        slotStatusBadge.className = availableCount > 0 ? 'badge text-bg-success small' : 'badge text-bg-secondary small';

                        // Check if an existing value was pre-selected
                        if (finalDateTimeInput.value) {
                            const matchingBtn = document.querySelector(`.slot-btn[data-slot="${finalDateTimeInput.value}"]`);
                            if (matchingBtn) selectSlot(matchingBtn, finalDateTimeInput.value);
                        }
                    })
                    .catch(err => {
                        console.error('Slot fetch error:', err);
                        slotsGrid.innerHTML = '<span class="text-danger small">Could not load time slots. Please try again.</span>';
                    });
            }

            window.selectSlot = function (btn, slotDateTime) {
                document.querySelectorAll('.slot-btn').forEach(b => {
                    b.classList.remove('btn-primary', 'text-white', 'fw-bold');
                    b.classList.add('btn-outline-primary');
                });
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-primary', 'text-white', 'fw-bold');
                finalDateTimeInput.value = slotDateTime;
            };

            if (emergencySwitch) {
                emergencySwitch.addEventListener('change', updateEmergencyUI);
                updateEmergencyUI();
            }

            if (doctorSelect) {
                doctorSelect.addEventListener('change', loadAvailableSlots);
            }

            if (slotDatePicker) {
                slotDatePicker.addEventListener('change', loadAvailableSlots);
            }

            // Initial load if doctor is already selected
            if (doctorSelect && doctorSelect.value) {
                loadAvailableSlots();
            }
        });
    </script>
}
