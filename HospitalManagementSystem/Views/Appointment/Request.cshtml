@model HospitalManagementSystem.Models.GuestAppointmentViewModel
@{
    ViewData["Title"] = "Request Appointment";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title mb-2">Request an Appointment</h3>
                <p class="text-muted">Choose an available doctor and submit your request. The hospital team will confirm it.</p>
                @if (ViewBag.Submitted == true)
                {
                    <div class="alert alert-success">Your appointment request was submitted successfully.</div>
                }
                <form asp-action="GuestRequest" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row">
                        <div class="col-md-6 mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /></div>
                        <div class="col-md-6 mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /></div>
                        <div class="col-md-6 mb-3"><label asp-for="Gender" class="form-label"></label><select asp-for="Gender" class="form-select"><option value="">Select</option><option>Female</option><option>Male</option><option>Other</option></select></div>
                        <div class="col-md-6 mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div>
                        <div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /></div>
                        <div class="col-md-6 mb-3"><label asp-for="DoctorId" class="form-label">Available doctor</label><select asp-for="DoctorId" class="form-select" asp-items="@(new SelectList(ViewBag.Doctors, "DoctorId", "FullName"))"><option value="">Select a doctor</option></select></div>
                        <div class="col-md-6 mb-3"><label asp-for="AppointmentDateTime" class="form-label"></label><input asp-for="AppointmentDateTime" class="form-control" type="datetime-local" /></div>
                        <div class="col-md-6 mb-3"><label asp-for="Reason" class="form-label"></label><input asp-for="Reason" class="form-control" /></div>
                    </div>
                    <div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div>
                    <button type="submit" class="btn btn-primary">Send request</button>
                </form>
            </div>
        </div>
    </div>
</div>
