@model HospitalManagementSystem.Models.Appointment
@{
    ViewData["Title"] = "Edit Appointment #" + Model.AppointmentId;
    var patients = ViewBag.Patients as IEnumerable<HospitalManagementSystem.Models.Patient> ?? Enumerable.Empty<HospitalManagementSystem.Models.Patient>();
    var doctors = ViewBag.Doctors as IEnumerable<HospitalManagementSystem.Models.Doctor> ?? Enumerable.Empty<HospitalManagementSystem.Models.Doctor>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <p class="eyebrow mb-1">CLINICAL EDIT</p>
                        <h3 class="card-title mb-0" style="font-family: 'Space Grotesk', sans-serif;">Appointment #@Model.AppointmentId</h3>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to List</a>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.AppointmentId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AppointmentId" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    @if (Model.IsEmergency)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                            <span class="fs-4">🚨</span>
                            <div>
                                <strong>Critical Emergency Appointment</strong>
                                <div class="small">@Model.EmergencyDescription</div>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Patient</label>
                        <select asp-for="PatientId" class="form-select">
                            @foreach (var p in patients)
                            {
                                <option value="@p.PatientId" selected="@(p.PatientId == Model.PatientId ? "selected" : null)">
                                    @p.FirstName @p.LastName (@p.MedicalRecordNumber | Tel: @p.PhoneNumber)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="PatientId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Attending Doctor</label>
                        <select asp-for="DoctorId" class="form-select">
                            @foreach (var d in doctors)
                            {
                                <option value="@d.DoctorId" selected="@(d.DoctorId == Model.DoctorId ? "selected" : null)">
                                    @d.FullName — @d.Specialty (@d.Qualification) [Room: @d.RoomNumber]
                                </option>
                            }
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AppointmentDateTime" class="form-label small fw-semibold">Date & Time</label>
                            <input asp-for="AppointmentDateTime" class="form-control" type="datetime-local" value="@Model.AppointmentDateTime.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="AppointmentDateTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold">Appointment Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Requested" selected="@(Model.Status == "Requested" ? "selected" : null)">Requested</option>
                                <option value="Approved" selected="@(Model.Status == "Approved" ? "selected" : null)">Approved</option>
                                <option value="Emergency" selected="@(Model.Status == "Emergency" ? "selected" : null)">Emergency</option>
                                <option value="Emergency - Accepted" selected="@(Model.Status == "Emergency - Accepted" ? "selected" : null)">Emergency - Accepted</option>
                                <option value="Checked-In" selected="@(Model.Status == "Checked-In" ? "selected" : null)">Checked-In</option>
                                <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">Completed</option>
                                <option value="Rejected" selected="@(Model.Status == "Rejected" ? "selected" : null)">Rejected</option>
                                <option value="Cancelled" selected="@(Model.Status == "Cancelled" ? "selected" : null)">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label small fw-semibold">Reason for Visit</label>
                        <input asp-for="Reason" class="form-control" />
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VitalsSummary" class="form-label small fw-semibold">Triage Vitals (Nurse Intake)</label>
                        <input asp-for="VitalsSummary" class="form-control font-monospace" placeholder="e.g. BP: 120/80 mmHg | Pulse: 72 bpm | Temp: 98.6°F | SpO2: 99%" />
                        <span asp-validation-for="VitalsSummary" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DoctorNotes" class="form-label small fw-semibold">Doctor Clinical & Prescription Notes</label>
                        <textarea asp-for="DoctorNotes" class="form-control" rows="3" placeholder="Physician diagnosis and medications..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label small fw-semibold">Administrative Remarks</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to Schedule</a>
                        <button class="btn btn-primary px-4" type="submit">Update Record &rarr;</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
