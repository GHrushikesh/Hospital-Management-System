@model HospitalManagementSystem.Models.Appointment
@{
    ViewData["Title"] = "Edit Appointment";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="card-title mb-0">Edit Appointment</h3>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
                </div>

                <form asp-action="Edit" asp-route-id="@Model.AppointmentId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AppointmentId" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Patient</label>
                        <select asp-for="PatientId" class="form-select">
                            @foreach (var patient in (IEnumerable<HospitalManagementSystem.Models.Patient>)ViewBag.Patients)
                            {
                                <option value="@patient.PatientId" selected="@(patient.PatientId == Model.PatientId ? "selected" : null)">
                                    @patient.FirstName @patient.LastName (@patient.PhoneNumber)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="PatientId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Doctor</label>
                        <select asp-for="DoctorId" class="form-select">
                            @foreach (var doctor in (IEnumerable<HospitalManagementSystem.Models.Doctor>)ViewBag.Doctors)
                            {
                                <option value="@doctor.DoctorId" selected="@(doctor.DoctorId == Model.DoctorId ? "selected" : null)">
                                    @doctor.FullName - @doctor.Specialty (@doctor.ConsultationFee.ToString("C"))
                                </option>
                            }
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AppointmentDateTime" class="form-label">Date & Time</label>
                        <input asp-for="AppointmentDateTime" class="form-control" type="datetime-local" value="@Model.AppointmentDateTime.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="AppointmentDateTime" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" class="form-label"></label>
                        <input asp-for="Reason" class="form-control" />
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Scheduled">Scheduled</option>
                            <option value="Completed">Completed</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="mt-4">
                        <button class="btn btn-primary" type="submit">Update Appointment</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
