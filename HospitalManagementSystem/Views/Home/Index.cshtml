@model HospitalManagementSystem.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">Patients</h5>
                <p class="display-6">@Model.PatientCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">Doctors</h5>
                <p class="display-6">@Model.DoctorCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">Appointments</h5>
                <p class="display-6">@Model.AppointmentCount</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <h3>Today's Appointments</h3>
    @if (Model.TodayAppointments.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.TodayAppointments)
                {
                    <tr>
                        <td>@appointment.PatientName</td>
                        <td>@appointment.DoctorName</td>
                        <td>@appointment.AppointmentDateTime.ToString("g")</td>
                        <td>@appointment.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No appointments for today.</div>
    }
</div>
