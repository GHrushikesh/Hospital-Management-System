@model IEnumerable<HospitalManagementSystem.Models.Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Patients</h2>
    @if (Context.Session.GetString("LoggedInUserRole") == "Admin")
    {
        <a asp-action="Create" class="btn btn-primary">Add Patient</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by name, phone, or email" />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Gender</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model)
        {
            <tr>
                <td>@patient.FirstName @patient.LastName</td>
                <td>@patient.PhoneNumber</td>
                <td>@patient.Email</td>
                <td>@patient.Gender</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@patient.PatientId" class="btn btn-sm btn-warning me-2">Edit</a>
                    <form asp-action="Delete" asp-route-id="@patient.PatientId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this patient?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
