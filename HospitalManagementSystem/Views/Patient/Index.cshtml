@model IEnumerable<HospitalManagementSystem.Models.Patient>
@{
    ViewData["Title"] = "Patient Master Index";
    var isAdmin = Context.Session.GetString("AdminAuthenticated") == "true" 
        || string.Equals(Context.Session.GetString("LoggedInUserRole"), "Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <p class="eyebrow mb-1">PATIENT DATABASE</p>
        <h2 style="font-family: 'Space Grotesk', sans-serif;">Patient Master Records</h2>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Register New Patient</a>
</div>

<!-- Search Box -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-8 col-sm-12">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search by name, phone number, email, or MRN..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="schedule-panel">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>MRN</th>
                    <th>Patient Name</th>
                    <th>Phone / Mobile</th>
                    <th>Email</th>
                    <th>Gender</th>
                    <th>Blood Group</th>
                    <th>Emergency Contact</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge text-bg-light border font-monospace">@patient.MedicalRecordNumber</span>
                            </td>
                            <td>
                                <strong class="d-block" style="color: var(--cb-ink);">@patient.FirstName @patient.LastName</strong>
                                <span class="text-muted small">DOB: @(patient.DateOfBirth?.ToString("dd MMM yyyy") ?? "—")</span>
                            </td>
                            <td>@patient.PhoneNumber</td>
                            <td>@(string.IsNullOrEmpty(patient.Email) ? "-" : patient.Email)</td>
                            <td>@patient.Gender</td>
                            <td>
                                @if (!string.IsNullOrEmpty(patient.BloodGroup))
                                {
                                    <span class="badge text-bg-secondary">@patient.BloodGroup</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td>
                                <div class="small">@(string.IsNullOrEmpty(patient.EmergencyContactName) ? "-" : patient.EmergencyContactName)</div>
                                <div class="text-muted small">@(string.IsNullOrEmpty(patient.EmergencyContactNumber) ? "" : patient.EmergencyContactNumber)</div>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@patient.PatientId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                @if (isAdmin)
                                {
                                    <form asp-action="Delete" asp-route-id="@patient.PatientId" method="post" class="d-inline" onsubmit="return confirm('Remove patient file @patient.FirstName @patient.LastName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            @(string.IsNullOrEmpty(ViewBag.SearchTerm as string) ? "No patients registered yet." : "No patient records found matching your search criteria.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
