@model HospitalManagementSystem.Models.Patient
@{
    ViewData["Title"] = "Edit Patient";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="card-title mb-3">Edit Patient</h3>
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="PatientId" type="hidden" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <input asp-for="Gender" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BloodGroup" class="form-label"></label>
                            <input asp-for="BloodGroup" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmergencyContactName" class="form-label"></label>
                            <input asp-for="EmergencyContactName" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label"></label>
                            <textarea asp-for="Address" class="form-control"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmergencyContactNumber" class="form-label"></label>
                            <input asp-for="EmergencyContactNumber" class="form-control" />
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" type="submit">Save Changes</button>
                    <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
                </form>
            </div>
        </div>
    </div>
</div>
