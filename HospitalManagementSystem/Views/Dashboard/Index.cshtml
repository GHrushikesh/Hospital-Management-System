@model HospitalManagementSystem.ViewModels.DashboardViewModel
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Admin Dashboard";
    var username = HttpContextAccessor.HttpContext?.Session.GetString("AdminUser") ?? "Admin";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-1 text-dark fw-bolder"><i class="fa-solid fa-chart-pie text-primary me-2"></i>Hospital Control Panel</h1>
        <p class="text-muted mb-0">Live diagnostic metrics and patient volume across your clinical departments.</p>
    </div>
    <div class="mt-3 mt-sm-0 d-flex align-items-center">
        <span class="badge bg-success bg-opacity-10 text-success p-2 px-3 fs-6 border border-success border-opacity-25 rounded-pill shadow-sm d-flex align-items-center">
            <span class="d-inline-block rounded-circle bg-success p-1 me-2" style="width: 8px; height: 8px;"></span>
            Database Active & Connected
        </span>
    </div>
</div>

<!-- Welcome Hero Card -->
<div class="card border-0 shadow-sm rounded-4 mb-5 text-white overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
    <div class="card-body p-4 p-md-5 d-flex align-items-center justify-content-between">
        <div class="me-4">
            <span class="badge bg-white bg-opacity-25 text-white mb-2 px-3 py-1 rounded-pill uppercase fw-bold" style="letter-spacing: 0.5px;">Milestone 1 Active</span>
            <h2 class="display-6 fw-bolder mb-3">Welcome Back, @username!</h2>
            <p class="lead mb-0 text-white-50" style="max-width: 650px;">
                You are currently accessing the central supervisory dashboard. Monitor registered patients, track medical specialist assignments, and review appointment loads in real-time.
            </p>
        </div>
        <div class="d-none d-xl-block text-white opacity-25 pe-3">
            <i class="fa-solid fa-hospital-user" style="font-size: 7.5rem;"></i>
        </div>
    </div>
</div>

<h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-simple text-primary me-2"></i>System Key Performance Indicators (KPIs)</h5>

<!-- Summary Statistics Grid -->
<div class="row g-4 mb-5">
    <!-- Total Patients Card -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 py-2 transition-hover" style="border-left: 6px solid #3b82f6 !important;">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="text-uppercase fw-bold text-primary mb-1" style="font-size: 0.75rem; letter-spacing: 0.05rem;">Total Patients</div>
                        <div class="h2 mb-0 fw-bolder text-dark">@Model.TotalPatients</div>
                        <div class="text-muted small mt-2 d-flex align-items-center">
                            <i class="fa-solid fa-arrow-trend-up text-success me-1"></i> 
                            <span>Registered records</span>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: rgba(59, 130, 246, 0.1); width: 64px; height: 64px;">
                            <i class="fa-solid fa-bed-pulse text-primary fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Doctors Card -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 py-2 transition-hover" style="border-left: 6px solid #10b981 !important;">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="text-uppercase fw-bold mb-1" style="color: #10b981; font-size: 0.75rem; letter-spacing: 0.05rem;">Total Doctors</div>
                        <div class="h2 mb-0 fw-bolder text-dark">@Model.TotalDoctors</div>
                        <div class="text-muted small mt-2 d-flex align-items-center">
                            <i class="fa-solid fa-user-doctor me-1" style="color: #10b981;"></i> 
                            <span>On duty practitioners</span>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: rgba(16, 185, 129, 0.1); width: 64px; height: 64px;">
                            <i class="fa-solid fa-stethoscope fs-3" style="color: #10b981;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Appointments Card -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 py-2 transition-hover" style="border-left: 6px solid #f59e0b !important;">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="text-uppercase fw-bold mb-1" style="color: #f59e0b; font-size: 0.75rem; letter-spacing: 0.05rem;">Appointments</div>
                        <div class="h2 mb-0 fw-bolder text-dark">@Model.TotalAppointments</div>
                        <div class="text-muted small mt-2 d-flex align-items-center">
                            <i class="fa-solid fa-calendar-check me-1" style="color: #f59e0b;"></i> 
                            <span>Booked schedules</span>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: rgba(245, 158, 11, 0.1); width: 64px; height: 64px;">
                            <i class="fa-solid fa-calendar-day fs-3" style="color: #f59e0b;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Bills Card -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 py-2 transition-hover" style="border-left: 6px solid #6366f1 !important;">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col">
                        <div class="text-uppercase fw-bold mb-1" style="color: #6366f1; font-size: 0.75rem; letter-spacing: 0.05rem;">Total Bills</div>
                        <div class="h2 mb-0 fw-bolder text-dark">@Model.TotalBills</div>
                        <div class="text-muted small mt-2 d-flex align-items-center">
                            <i class="fa-solid fa-circle-info text-secondary me-1"></i> 
                            <span>Billing module pending</span>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background-color: rgba(99, 102, 241, 0.1); width: 64px; height: 64px;">
                            <i class="fa-solid fa-file-invoice-dollar fs-3" style="color: #6366f1;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.25s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.25s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.12) !important;
    }
</style>
